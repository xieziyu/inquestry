{
  "name": "inquestry",
  "productName": "Inquestry",
  "version": "0.0.0",
  "description": "Troubleshooting console for software engineers — evidence-first timeline over a live agent session",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "icons:gen": "tsx scripts/gen-icons.ts",
    "spike:claude": "tsx scripts/spike-claude.ts",
    "spike:db": "tsx scripts/spike-db.ts",
    "spike:tools": "tsx scripts/spike-tools.ts",
    "spike:wire": "tsx scripts/spike-wire.ts",
    "spike:lane": "tsx scripts/spike-lane.ts",
    "spike:automode": "tsx scripts/spike-automode.ts",
    "spike:gate": "tsx scripts/spike-gate.ts",
    "spike:cases": "tsx scripts/spike-cases.ts",
    "spike:close": "tsx scripts/spike-close.ts",
    "spike:track": "tsx scripts/spike-track.ts",
    "spike:stage": "tsx scripts/spike-stage.ts",
    "spike:report": "tsx scripts/spike-report.ts",
    "spike:markdown": "tsx scripts/spike-markdown.ts",
    "spike:image": "tsx scripts/spike-image.ts",
    "spike:branch": "tsx scripts/spike-branch.ts",
    "spike:timebase": "tsx scripts/spike-timebase.ts",
    "spike:all": "npm run rebuild:node && npm run spike:db && npm run spike:gate && npm run spike:cases && npm run spike:timebase && npm run spike:close && npm run spike:track && npm run spike:stage && npm run spike:branch && npm run spike:report && npm run spike:markdown && npm run spike:image",
    "seed": "npm run rebuild:node && tsx scripts/seed-cases.ts",
    "start": "electron-vite dev",
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "app": "npm run rebuild:electron && electron-vite preview",
    "preview:ui": "vite --config vite.preview.config.ts --port 5178 --strictPort",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "cd node_modules/better-sqlite3 && npm run build-release"
  },
  "author": {
    "name": "xieziyu",
    "email": "rainnyxzy@gmail.com"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "better-sqlite3": "^12.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  },
  "main": "out/main/index.js"
}
